# Server-side only. Never use a VITE_ prefix for secrets.
GEMINI_API_KEY=
# Verified in official Google documentation; no automatic fallback model.
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
# Replace CHANGE_ME in both values before first database initialization.
DATABASE_URL=postgresql+psycopg://voxpilot:CHANGE_ME@db:5432/voxpilot
POSTGRES_PASSWORD=CHANGE_ME
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=24
MAX_INPUT_CHARACTERS=12000
MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=90
CONTEXT_MESSAGES=20
CONTEXT_CHARACTERS=24000
MAX_UPLOAD_BYTES=5242880
MAX_DOCUMENT_CHARACTERS=100000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.3
TRACE_RETENTION_DAYS=7
RATE_LIMIT_PER_MINUTE=60
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Local speech-to-text: no Gemini key required. First use downloads multilingual weights.
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=4
STT_MODEL_CACHE=/models
STT_MAX_UPLOAD_BYTES=10485760
STT_MAX_DURATION_SECONDS=60
STT_MIN_DURATION_SECONDS=0.4
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_ETAG_TIMEOUT=30
